<UserControl x:Class="AudioManager.Views.AppsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:AudioManager.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             FontFamily="{StaticResource Vm.DisplayFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True">
            <ItemsControl ItemsSource="{Binding ActiveAudioApps}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Vm.AppCard}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"
                                Padding="14,12">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="42"
                                       Height="42"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,18,0">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding DisplayNameSpaced}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{StaticResource Vm.TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}"
                                               SnapsToDevicePixels="True"
                                               UseLayoutRounding="True"
                                               TextOptions.TextFormattingMode="Display" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding DataContext.AssignableChannelOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding AssignedChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="NameSpaced"
                                          Style="{StaticResource Vm.ComboBox}"
                                          ItemContainerStyle="{StaticResource Vm.ComboBoxItem}"
                                          VerticalAlignment="Center"
                                          Visibility="Visible" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource Vm.ScrollBarVertical}" />
            </ScrollViewer.Resources>
        </ScrollViewer>

        <Button Grid.Row="1"
                Content="R&#x2009;e&#x2009;f&#x2009;r&#x2009;e&#x2009;s&#x2009;h&#x2009; &#x2009;A&#x2009;p&#x2009;p&#x2009;s"
                Command="{Binding DataContext.RefreshPlayingAudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource Vm.SmallButton}"
                HorizontalAlignment="Right"
                Height="32"
                Margin="0,14,0,0" />
    </Grid>
</UserControl>
